  "exerciseLibrary": [
    {
      "id": "bb_bench",
      "name": "Barbell bench press",
      "equipment": "barbell",
      "pattern": "horizontal_push",
      "primary": [
        "chest"
      ],
      "secondary": [
        "triceps",
        "front_delts"
      ],
      "defaultRestSec": 150,
      "cues": {
        "setup": [
          "Eyes under the bar, shoulder blades pinched and down, feet planted."
        ],
        "move": [
          "Lower to mid/lower chest under control, press up and slightly back toward the rack."
        ],
        "avoid": [
          "Bouncing the bar off the chest or letting the butt lift off the bench."
        ]
      }
    },
    {
      "id": "cg_bench",
