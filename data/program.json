          "Hands about shoulder-width (not narrower), same setup as regular bench."
        ],
        "move": [
          "Elbows tucked closer to the torso, touch lower chest, press to lockout."
        ],
        "avoid": [
          "Gripping so narrow that wrists bend back and hurt."
        ]
      }
    },
